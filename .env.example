# Copy to .env.local and fill in real values for local dev.
# Production / Preview values are managed in the Vercel project settings.
#
# Each public form (quote, contact) needs AT LEAST ONE delivery channel:
#   - Channel A: webhook (*_ENDPOINT)
#   - Channel B: Resend email (RESEND_API_KEY + *_NOTIFICATION_FROM/TO)
# Configuring both gives you redundancy. /api/health reports channel status.

# --- Site ---------------------------------------------------------------
# Canonical site origin (must match the canonical production host). Required in
# production; used by the request proxy Origin/Referer (CSRF) check. Metadata
# and SEO URLs come from the constant in src/lib/site.ts.
SITE_URL=https://caraway.au

# --- AI chat ------------------------------------------------------------
# Production and preview deployments authenticate to Vercel AI Gateway with
# Vercel automatically supplies OIDC credentials to deployed Functions. Set
# AI_GATEWAY_API_KEY only for local development outside `vercel dev`.
AI_GATEWAY_API_KEY=

# --- Form delivery: webhooks (Channel A) --------------------------------
# HTTPS webhook URLs the server actions POST to.
QUOTE_ENDPOINT=
CONTACT_ENDPOINT=

# Comma-separated hostname allowlist for outbound webhook calls (SSRF
# defense-in-depth). Required whenever *_ENDPOINT is set.
ALLOWED_ENDPOINT_HOSTS=

# --- Form delivery: email via Resend (Channel B) ------------------------
# Resend API key. Required to enable either email channel.
RESEND_API_KEY=

# Quote notification email. FROM must be on a Resend-verified domain.
QUOTE_NOTIFICATION_FROM="Caraway Quotes <quotes@caraway.au>"
QUOTE_NOTIFICATION_TO=info@caraway.au

# Contact notification email. FROM must be on a Resend-verified domain.
CONTACT_NOTIFICATION_FROM="Caraway Contact <contact@caraway.au>"
CONTACT_NOTIFICATION_TO=info@caraway.au

# --- Google Places (address autocomplete) -------------------------------
# Server-side key for /api/places/autocomplete. Restrict to the Places
# API (New) in Google Cloud Console. Leave blank to disable autocomplete
# and fall back to plain text input.
GOOGLE_PLACES_API_KEY=

# Dedicated HMAC secret for the short-lived Places session tokens (any long
# random string, e.g. `openssl rand -base64 32`). Falls back to the API key
# when unset; set it so token signing survives API-key rotation and the key
# never doubles as a crypto secret.
PLACES_SESSION_SECRET=

# --- Distributed rate limiting -----------------------------------------
# Required in production and preview. The Vercel Marketplace sets the KV pair;
# direct Upstash setups can use the UPSTASH pair. Configure one complete pair.
# Development and test use a per-process fallback; every other runtime fails
# closed. /api/health returns 503 when these settings are absent or malformed;
# connectivity, auth, and timeout failures surface at the protected route and
# authenticated synthetic monitor.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Synthetic lead delivery monitoring --------------------------------
# Vercel Cron calls the protected monitor route once daily. Enable only
# after webhook/email recipients are prepared to ignore labeled monitor leads.
CRON_SECRET=
LEAD_MONITOR_ENABLED=0
