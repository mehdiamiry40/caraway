{
  "name": "caraway",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "turbo:check": "turbo run lint typecheck test:coverage",
    "turbo:build": "turbo run build",
    "turbo:verify": "turbo run check:indexability check:bundle check:headings check:links check:crawl",
    "start": "next start",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "eslint . --max-warnings 0 && npm run check:content",
    "check:content": "node scripts/check-content-integrity.mjs",
    "check:indexability": "node scripts/check-indexability.mjs",
    "check:crawl": "node scripts/check-site-crawl.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:headings": "node scripts/check-heading-order.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:sources": "node scripts/check-source-links.mjs",
    "seo:indexnow": "node scripts/indexnow-submit.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "audit:swarm": "node scripts/swarm-audit.mjs",
    "data:vehicle": "node scripts/build-queensland-vehicle-data.mjs",
