    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.10",
    "eslint": "^9.21.0",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.0.2",
    "jsqr": "^1.4.0",
    "postcss": "8.5.25",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "turbo": "2.10.11",
