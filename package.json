    "@vercel/oidc": "3.2.0",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.52",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "7.72.1",
    "resend": "^6.12.4",
    "tailwind-merge": "3.5.0",
    "zod": "4.4.3"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead",
    "not op_mini all"
