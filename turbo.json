{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "AI_GATEWAY_API_KEY",
        "ALLOWED_ENDPOINT_HOSTS",
        "CONTACT_ENDPOINT",
        "CONTACT_NOTIFICATION_FROM",
        "CONTACT_NOTIFICATION_TO",
        "CRON_SECRET",
        "DEBUG_PLACES",
        "GOOGLE_PLACES_API_KEY",
        "KV_REST_API_TOKEN",
        "KV_REST_API_URL",
        "LEAD_MONITOR_ENABLED",
        "NEXT_PUBLIC_*",
        "PLACES_SESSION_SECRET",
        "QUOTE_ENDPOINT",
        "QUOTE_NOTIFICATION_FROM",
        "QUOTE_NOTIFICATION_TO",
        "RESEND_API_KEY",
        "SITE_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "UPSTASH_REDIS_REST_URL",
        "VERCEL_ENV",
        "VERCEL_GIT_COMMIT_SHA",
        "VERCEL_REGION"
      ],
      "passThroughEnv": ["VERCEL_OIDC_TOKEN"]
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "cache": false
    },
    "check:indexability": {
      "dependsOn": ["build"]
    },
    "check:bundle": {
      "dependsOn": ["build"]
    },
    "check:headings": {
      "dependsOn": ["build"]
    },
    "check:links": {
      "dependsOn": ["build"]
    },
    "check:crawl": {
      "dependsOn": ["build"]
    },
    "check:sources": {
      "cache": false
    },
    "seo:indexnow": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    }
  }
}
