{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "turbo run build",
  "regions": ["syd1"],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "crons": [
    {
      "path": "/api/health/lead-delivery",
      "schedule": "0 21 * * *"
    }
  ]
}
